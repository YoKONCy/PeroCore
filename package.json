{
  "name": "perocore-ts",
  "private": true,
  "version": "0.1.0",
  "description": "PeroCore-TS — 萌动链接：PeroperoChat！的 TypeScript 全栈引擎",
  "author": "YoKONCy",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/YoKONCy/PeroCore.git"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "pnpm --filter @perocore/backend dev",
    "dev:frontend": "pnpm --filter @perocore/frontend dev",
    "build": "pnpm -r run build",
    "clean": "pnpm -r run clean",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "test:shared": "vitest run --project packages/shared",
    "test:backend": "vitest run --project packages/backend",
    "test:frontend": "vitest run --project packages/frontend",
    "lint": "eslint . --ext .vue,.js,.ts,.jsx,.tsx",
    "lint:fix": "eslint . --ext .vue,.js,.ts,.jsx,.tsx --fix",
    "format": "prettier --write \"packages/*/src/**/*.{ts,vue,css,json}\"",
    "format:check": "prettier --check \"packages/*/src/**/*.{ts,vue,css,json}\"",
    "typecheck": "pnpm -r run typecheck"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-vue": "^9.33.0",
    "prettier": "^3.8.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18",
    "vue-eslint-parser": "^10.4.0"
  }
}
