{
  "name": "@infos/arca",
  "version": "0.9.3",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./manifest": "./src/manifest.ts",
    "./client": "./client/src/main.ts",
    "./*": "./src/*"
  },
  "scripts": {
    "dev": "pnpm dev:host",
    "dev:host": "tsx src/main.ts",
    "dev:client": "vite --config client/vite.config.ts",
    "build": "pnpm build:host && pnpm build:client",
    "build:host": "tsc -p tsconfig.host.json",
    "build:client": "vite build --config client/vite.config.ts",
    "typecheck": "pnpm typecheck:host && pnpm typecheck:client",
    "typecheck:host": "tsc -p tsconfig.host.json --noEmit",
    "typecheck:client": "vue-tsc -p tsconfig.client.json --noEmit",
    "clean": "rimraf dist client/dist"
  },
  "dependencies": {
    "@infos/document-engine": "workspace:*",
    "@infos/node-host": "workspace:*",
    "@infos/node-sdk": "workspace:*",
    "@infos/shared": "workspace:*",
    "pinia": "^3.0.0",
    "tiktoken": "1.0.22",
    "vue": "^3.5.42",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.5.0",
    "@types/node": "^22.15.0",
    "jsdom": "^30.0.1",
    "rimraf": "^6.1.2",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "vite": "^6.2.0",
    "vue-tsc": "^2.2.0"
  }
}
