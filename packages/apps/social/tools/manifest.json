{
  "id": "social-ops",
  "name": "社交平台操作",
  "version": "1.0.0",
  "author": "infOS Team",
  "description": "社交流程工具；三个业务工具的共享契约定义于 @infos/shared/socialTools。",
  "type": "tool",
  "entry": "index.ts",
  "category": "core",
  "platforms": ["windows", "darwin", "linux"],
  "tools": [
    {
      "name": "manage_task",
      "description": "创建、查询或调整任务；操作已有任务前，先用 list/get 确认目标与版本。",
      "display": {
        "label": "管理任务",
        "description": "安排任务，查看进展或调整执行。",
        "icon": "list",
        "color": "purple"
      },
      "parameters": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "create",
              "list",
              "get",
              "update",
              "pause",
              "resume",
              "cancel",
              "answer",
              "approve",
              "resolve_delivery"
            ]
          },
          "taskId": {
            "type": "string"
          },
          "expectedRevision": {
            "type": "integer",
            "description": "除 create/list/get 外必填，取自任务当前 revision"
          },
          "instruction": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "successCriteria": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "inputId": {
            "type": "string"
          },
          "selectedOptionIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "decision": {
            "type": "string",
            "enum": ["allow_once", "deny_once"]
          },
          "recovery": {
            "type": "string",
            "enum": ["read_only", "confirm"]
          },
          "confirmUncertain": {
            "type": "boolean",
            "description": "仅用户明确核验过结果不明的动作后，才可设为 true"
          },
          "deadline": {
            "type": "string",
            "description": "用户指定的截止时间，ISO 8601"
          },
          "maxSegments": {
            "type": "integer"
          },
          "maxLlmCalls": {
            "type": "integer"
          },
          "maxToolCalls": {
            "type": "integer"
          },
          "deliveryId": {
            "type": "string"
          },
          "deliveryDecision": {
            "type": "string",
            "description": "仅用户确认已送达或未送达后，才可标记 sent 或要求 retry",
            "enum": ["sent", "retry"]
          },
          "answers": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "description": "answer操作：按题目ID一次提交整组回答。",
            "items": {
              "type": "object",
              "properties": {
                "questionId": {
                  "type": "string"
                },
                "selectedOptionIds": {
                  "type": "array",
                  "maxItems": 4,
                  "items": {
                    "type": "string"
                  }
                },
                "message": {
                  "type": "string",
                  "maxLength": 4000
                }
              },
              "required": ["questionId"],
              "additionalProperties": false
            }
          }
        },
        "required": ["action"],
        "additionalProperties": false
      }
    }
  ]
}
