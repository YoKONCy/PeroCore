{
  "id": "ask-user",
  "name": "askUser",
  "displayName": "向用户求助",
  "version": "1.0.0",
  "description": "在缺少必要信息时向用户提问，并等待用户回答后继续当前工作。",
  "type": "tool",
  "entry": "index.ts",
  "category": "system",
  "platforms": ["windows", "linux", "darwin", "docker"],
  "registration": "static",
  "tools": [
    {
      "name": "ask_user",
      "description": "一次询问一至八个问题，用户可选选项、自由回答或补充，全部填好后统一提交；10分钟未回应，非必答可跳过，必答保留待答。",
      "parameters": {
        "type": "object",
        "properties": {
          "questions": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "items": {
              "type": "object",
              "properties": {
                "question": {
                  "type": "string",
                  "description": "需要用户回答的明确问题，最多2000字。"
                },
                "context": {
                  "type": "string",
                  "description": "为什么需要这项信息，最多2000字。"
                },
                "options": {
                  "type": "array",
                  "maxItems": 4,
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string"
                      },
                      "label": {
                        "type": "string"
                      },
                      "description": {
                        "type": "string"
                      }
                    },
                    "required": ["id", "label"],
                    "additionalProperties": false
                  }
                },
                "id": {
                  "type": "string",
                  "description": "题目ID，组内唯一。"
                },
                "multiple": {
                  "type": "boolean",
                  "description": "允许多选，默认单选。"
                }
              },
              "required": ["id", "question"],
              "additionalProperties": false
            }
          },
          "required": {
            "type": "boolean",
            "description": "缺少回答就无法继续时设为 true；默认 false，允许跳过或超时后按合理假设处理。"
          }
        },
        "required": ["questions"],
        "additionalProperties": false
      },
      "display": {
        "label": "向你提问",
        "description": "助手需要你的回答才能继续当前工作。",
        "icon": "chat",
        "color": "blue",
        "style": "system"
      }
    }
  ]
}
