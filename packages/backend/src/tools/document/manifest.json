{
  "id": "document",
  "name": "文档处理",
  "version": "1.0.0",
  "type": "tool",
  "entry": "index.ts",
  "category": "workspace",
  "platforms": ["windows", "linux", "darwin", "docker"],
  "tools": [
    {
      "name": "document",
      "description": "工作模式文档工具。action=capabilities 查询当前可用格式、PDF 引擎及 workbook 示例；inspect 检查结构；read 分页提取 Markdown（offset/limit），内嵌图片返回附件引用；export 从 source 或 content 导出 md/pdf/docx，或从 Markdown 表格、JSON workbook、workbook 参数导出 xlsx。source 支持工作区路径或当前会话 attachment:ID。PDF 默认 pdfkit；在线 Electron 提供可选 chromium。工作文件放任务子目录，output 不覆盖已有文件；省略时自动保存。生成后用 send_file 交付。扫描 PDF 需要已有 OCR 功能，工具不自动上传外部服务。",
      "display": {
        "label": "处理文档",
        "description": "读取文档，导出 PDF、Word 和 Excel。",
        "icon": "file",
        "color": "sky",
        "style": "file"
      },
      "parameters": {
        "type": "object",
        "properties": {
          "action": { "type": "string", "enum": ["capabilities", "inspect", "read", "export"] },
          "source": { "type": "string", "description": "工作区路径或当前会话 attachment:附件ID" },
          "content": {
            "type": "string",
            "description": "直接提供 Markdown；与 source、workbook 三选一"
          },
          "format": { "type": "string", "enum": ["md", "pdf", "docx", "xlsx"] },
          "output": {
            "type": "string",
            "description": "任务子目录中的输出路径；可省略，禁止覆盖已有不同内容"
          },
          "engine": {
            "type": "string",
            "enum": ["pdfkit", "chromium"],
            "description": "仅 PDF；默认 pdfkit，chromium 需在线渲染节点"
          },
          "template": { "type": "string", "enum": ["standard", "compact"] },
          "paper": { "type": "string", "enum": ["A4", "Letter"] },
          "landscape": { "type": "boolean" },
          "marginMm": { "type": "number", "minimum": 8, "maximum": 40 },
          "title": { "type": "string" },
          "offset": { "type": "integer", "minimum": 0 },
          "limit": { "type": "integer", "minimum": 1, "maximum": 32000 },
          "tableIndex": {
            "type": "integer",
            "minimum": 1,
            "description": "Markdown 多表格时选择第几张，从 1 开始"
          },
          "workbook": {
            "type": "object",
            "description": "仅 XLSX：sheets 工作表数组；rows 支持文本、数值、布尔值、null 和显式公式对象",
            "properties": {
              "sheets": {
                "type": "array",
                "minItems": 1,
                "maxItems": 20,
                "items": {
                  "type": "object",
                  "properties": {
                    "name": { "type": "string", "maxLength": 31 },
                    "columns": { "type": "array", "items": { "type": "string" } },
                    "rows": {
                      "type": "array",
                      "items": {
                        "type": "array",
                        "items": {
                          "anyOf": [
                            { "type": "string" },
                            { "type": "number" },
                            { "type": "boolean" },
                            { "type": "null" },
                            {
                              "type": "object",
                              "properties": {
                                "formula": { "type": "string" },
                                "result": { "type": ["number", "string", "boolean"] }
                              },
                              "required": ["formula"],
                              "additionalProperties": false
                            }
                          ]
                        }
                      }
                    },
                    "freezeHeader": { "type": "boolean" }
                  },
                  "required": ["name", "rows"],
                  "additionalProperties": false
                }
              }
            },
            "required": ["sheets"],
            "additionalProperties": false
          }
        },
        "required": ["action"],
        "additionalProperties": false
      }
    }
  ]
}
