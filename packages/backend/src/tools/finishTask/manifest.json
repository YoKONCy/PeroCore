      "type": "object",
      "properties": {
        "summary": { "type": "string", "description": "任务完成总结" },
        "status": { "type": "string", "description": "完成状态", "enum": ["done", "partial", "failed"] }
      },
      "required": ["summary"]
    }
  }
}
