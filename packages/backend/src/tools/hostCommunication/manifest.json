{
  "id": "host_communication",
  "toolDefinition": {
    "name": "communicate_with_host",
    "description": "与宿主主 Agent 临时交换信息，不写入主会话。",
    "display": {
      "label": "联系主助手",
      "description": "让应用中的助手与主助手临时交换任务信息。",
      "icon": "message",
      "color": "pink",
      "style": "default"
    },
    "parameters": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "consult",
            "verify",
            "approval",
            "request_resource",
            "report",
            "clarify",
            "complete"
          ]
        },
        "summary": { "type": "string", "description": "需要宿主处理的简洁请求" },
        "context": { "type": "object", "description": "最小必要辅助上下文" }
      },
      "required": ["mode", "summary"]
    }
  }
}
