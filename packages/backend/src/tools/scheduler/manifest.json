{
  "id": "scheduler",
  "name": "提醒日程",
  "version": "1.0.0",
  "author": "infOS Team",
  "description": "为主人设置提醒、话题和预设反应。支持创建、查看、取消三种操作。",
  "type": "tool",
  "entry": "index.ts",
  "category": "core",
  "platforms": ["windows", "linux", "darwin", "docker"],
  "userCopy": {
    "set_reminder": { "label": "创建提醒", "description": "按指定时间创建提醒。" },
    "list_reminders": { "label": "查看提醒", "description": "查看当前已有的提醒。" },
    "cancel_reminder": { "label": "取消提醒", "description": "删除不再需要的提醒。" }
  },
  "tools": [
    {
      "name": "set_reminder",
      "description": "为主人设置一个提醒、话题或预设反应。当主人说\"帮我设个提醒\"、\"XX点提醒我\"等场景时使用。",
      "display": { "label": "设置提醒", "icon": "clock", "color": "orange", "style": "reminder" },
      "parameters": {
        "type": "object",
        "properties": {
          "time": {
            "type": "string",
            "description": "触发时间，ISO 8601 格式。例如 \"2026-04-21T08:00:00\"。如果主人说\"5分钟后\"，需要计算具体的 ISO 时间。"
          },
          "content": {
            "type": "string",
            "description": "提醒内容。例如 \"该喝水啦\" 或 \"提醒主人开会\"。"
          },
          "type": {
            "type": "string",
            "description": "类型: \"reminder\" (一次性提醒，默认) | \"topic\" (想找主人聊的话题) | \"reaction\" (预设反应)",
            "enum": ["reminder", "topic", "reaction"]
          }
        },
        "required": ["time", "content"]
      }
    },
    {
      "name": "list_reminders",
      "description": "查看当前所有待触发的提醒、话题和反应。当主人问\"我设了什么提醒\"、\"有什么待办\"等场景时使用。",
      "display": {
        "label": "提醒列表",
        "icon": "calendar",
        "color": "orange",
        "style": "reminder"
      },
      "parameters": {
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "cancel_reminder",
      "description": "取消一个待触发的提醒。当主人说\"取消那个提醒\"、\"不用提醒我了\"等场景时使用。需要先用 list_reminders 获取 ID。",
      "display": { "label": "取消提醒", "icon": "close", "color": "orange", "style": "reminder" },
      "parameters": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number",
            "description": "要取消的提醒 ID (从 list_reminders 获取)"
          }
        },
        "required": ["id"]
      }
    }
  ]
}
