{
  "id": "social-ops",
  "name": "社交平台操作",
  "version": "1.0.0",
  "author": "infOS Team",
  "description": "通过社交子应用向主人发送通知；社交业务操作由社交助手在应用内部执行。",
  "type": "tool",
  "entry": "index.ts",
  "category": "core",
  "platforms": ["windows", "darwin", "linux"],
  "userCopy": {
    "social_notify_owner": {
      "label": "通知主人",
      "description": "通过已连接的社交渠道向主人发送通知。"
    }
  },
  "tools": [
    {
      "name": "social_notify_owner",
      "description": "向主人报告重要的社交事件或信息。消息会通过社交平台或系统通知渠道发送给主人。",
      "display": {
        "label": "通知主人",
        "icon": "chat",
        "color": "pink",
        "style": "social"
      },
      "parameters": {
        "type": "object",
        "properties": {
          "content": {
            "type": "string",
            "description": "通知内容"
          },
          "importance": {
            "type": "string",
            "description": "重要程度",
            "enum": ["low", "medium", "high"]
          }
        },
        "required": ["content"]
      }
    }
  ]
}
