{
  "id": "update-plan",
  "name": "行动计划",
  "version": "1.0.0",
  "type": "tool",
  "entry": "index.ts",
  "toolDefinition": {
    "name": "update_plan",
    "description": "维护当前会话或任务的公开行动清单，适合多步骤工作中记录待办、进行中、完成或受阻状态。它不创建后台任务，也不执行清单中的操作。更新时提交完整步骤，保留步骤 ID 并携带当前 revision；简单问答无需列计划。仅工作模式可用。",
    "display": {
      "label": "更新计划",
      "description": "维护当前工作的步骤与进度，标记完成或受阻；不会创建后台任务。仅工作模式可用。",
      "icon": "list",
      "color": "purple"
    },
    "parameters": {
      "type": "object",
      "properties": {
        "action": { "type": "string", "enum": ["create", "update", "get", "clear"] },
        "expectedRevision": {
          "type": "integer",
          "description": "update/clear必填，取自当前计划revision。"
        },
        "title": { "type": "string", "maxLength": 120 },
        "steps": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string", "maxLength": 80 },
              "title": { "type": "string", "maxLength": 300 },
              "status": {
                "type": "string",
                "enum": ["pending", "in_progress", "completed", "blocked"]
              }
            },
            "required": ["id", "title", "status"],
            "additionalProperties": false
          }
        }
      },
      "required": ["action"],
      "additionalProperties": false
    }
  }
}
