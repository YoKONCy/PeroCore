{
  "id": "web-fetch",
  "name": "网页抓取",
  "version": "1.0.0",
  "author": "infOS Team",
  "description": "轻量级 HTTP 网页文本抓取。使用 Node.js 原生 fetch，完全跨平台。",
  "type": "tool",
  "entry": "index.ts",
  "category": "core",
  "platforms": ["windows", "linux", "darwin", "docker"],

  "toolDefinition": {
    "name": "web_fetch",
    "description": "获取网页的文本内容。用于快速阅读文章、查看文档、获取静态页面信息。",
    "display": { "label": "抓取网页", "icon": "globe", "color": "sky", "style": "web" },
    "parameters": {
      "type": "object",
      "properties": {
        "url": { "type": "string", "description": "要获取的网页 URL" },
        "max_length": { "type": "number", "description": "最大返回字符数 (默认 20000)" }
      },
      "required": ["url"]
    }
  }
}
