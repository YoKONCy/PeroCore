{
  "id": "workspace-productivity",
  "name": "workspace_productivity",
  "version": "1.0.0",
  "displayName": "工作区生产力工具",
  "description": "范围读取、Glob 与带版本保护的精确原子编辑",
  "type": "tool",
  "entry": "index.ts",
  "category": "workspace",
  "platforms": ["windows", "linux", "darwin", "docker"],
  "userCopy": {
    "read_file_range": {
      "label": "读取文件片段",
      "description": "只读取文件中的指定部分，适合查看大文件。"
    },
    "glob_files": {
      "label": "按名称查找文件",
      "description": "根据文件名或路径规则批量查找文件。"
    },
    "edit_file": { "label": "编辑文件", "description": "精确修改文件中的一段内容。" }
  },
  "registration": "static",
  "permissions": ["filesystem:read", "filesystem:write"],
  "tools": [
    {
      "name": "read_file_range",
      "description": "按字符范围、行范围或尾部行读取文本文件；行级读取单次最多800行，并返回哈希、截断信息与文件总行数",
      "display": { "label": "读取文件", "icon": "file", "color": "sky", "style": "read" },
      "parameters": {
        "type": "object",
        "properties": {
          "path": { "type": "string" },
          "offset": { "type": "number" },
          "limit": { "type": "number" },
          "line_start": { "type": "number", "minimum": 1, "description": "起始行号，从1开始" },
          "line_end": {
            "type": "number",
            "minimum": 1,
            "description": "结束行号（包含）；省略时默认读取800行，超出800行的请求会截断"
          },
          "tail_lines": {
            "type": "number",
            "minimum": 1,
            "maximum": 800,
            "description": "读取文件尾部行数，最多800行"
          }
        },
        "required": ["path"]
      }
    },
    {
      "name": "glob_files",
      "description": "在设备文件系统中按 Glob 模式查找文件；相对目录仍以当前工作区为基准",
      "display": { "label": "查找文件", "icon": "search", "color": "purple", "style": "search" },
      "parameters": {
        "type": "object",
        "properties": {
          "pattern": { "type": "string" },
          "cwd": { "type": "string" },
          "max_depth": { "type": "number" },
          "limit": { "type": "number" },
          "include_hidden": { "type": "boolean" }
        },
        "required": ["pattern"]
      }
    },
    {
      "name": "edit_file",
      "description": "使用唯一 old_text 匹配精确编辑文本文件，支持 expected_hash 并发保护和原子替换",
      "display": { "label": "编辑文件", "icon": "edit", "color": "pink", "style": "edit" },
      "parameters": {
        "type": "object",
        "properties": {
          "path": { "type": "string" },
          "old_text": { "type": "string" },
          "new_text": { "type": "string" },
          "expected_hash": { "type": "string" }
        },
        "required": ["path", "old_text", "new_text"]
      }
    }
  ],
  "compatibility": { "platforms": ["windows", "linux", "darwin", "docker"] }
}
