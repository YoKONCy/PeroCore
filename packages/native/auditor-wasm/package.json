{
  "name": "@infos/auditor-wasm",
  "version": "0.9.2-rc1",
  "description": "infOS 终端命令安全审计模块 (WASM)",
  "type": "module",
  "main": "index.ts",
  "types": "index.d.ts",
  "scripts": {
    "build:wasm": "cargo build --release --target wasm32-unknown-unknown && node scripts/copy-wasm.mjs",
    "build:ts": "tsc -p tsconfig.json",
    "build": "pnpm build:wasm && pnpm build:ts",
    "test:rust": "cargo test"
  }
}
