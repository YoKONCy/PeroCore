{
  "name": "@infos/nit-runtime",
  "version": "0.9.2-rc1",
  "description": "infOS Rust N-API: minGRU 推理/训练 + Leiden 聚类",
  "main": "index.ts",
  "types": "index.ts",
  "napi": {
    "name": "nit-runtime",
    "triples": {
      "defaults": true,
      "additional": []
    }
  },
  "scripts": {
    "build:native": "napi build --platform --release --js false",
    "build:ts": "tsc -p tsconfig.json",
    "build": "pnpm build:native && pnpm build:ts",
    "build:debug": "napi build --platform --js false",
    "test": "cargo test"
  },
  "devDependencies": {
    "@napi-rs/cli": "^2.14.0"
  },
  "files": [
    "dist",
    "index.d.ts",
    "*.node"
  ]
}
