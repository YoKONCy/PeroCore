//————————————————————————————————————————————————————————————————————————————————//
//碰墙抬手动画by羊毛
//本代码采用MIT-0协议开源

//请保证此代码所占用的控制器为高并行动画，且为空白。如："@player_ctrl_parallel_5.molang"
//请在动画中添加名为defWall的抬手动画
//————————————————————————————————————————————————————————————————————————————————//

//北
query.relative_block_has_any_tag(0, 1.5, -1,'minecraft:replaceable') ? {
    v.n = true;
} : {
    v.n = false;
    v.twoBlocks = false;
};
v.n ? {
    query.relative_block_has_any_tag(0, 1.5, -2,'minecraft:replaceable') ? {
        v.n = true;
    } : {
        v.n = false;
        v.twoBlocks = true;
    };
};
v.n ? {
    query.relative_block_has_any_tag(1, 1.5, -2,'minecraft:replaceable') ? {
        v.n = true;
    } : {
        v.n = false;
        v.twoBlocks = true;
    };
};
v.n ? {
    query.relative_block_has_any_tag(-1, 1.5, -2,'minecraft:replaceable') ? {
        v.n = true;
    } : {
        v.n = false;
        v.twoBlocks = true;
    };
};

//西
query.relative_block_has_any_tag(-1, 1.5, 0,'minecraft:replaceable') ? {
    v.w = true;
} : {
    v.w = false;
    v.twoBlocks = false;
};
v.w ? {
    query.relative_block_has_any_tag(-2, 1.5, 0,'minecraft:replaceable') ? {
        v.w = true;
    } : {
        v.w = false;
        v.twoBlocks = true;
    };
};
v.w ? {
    query.relative_block_has_any_tag(-2, 1.5, 1,'minecraft:replaceable') ? {
        v.w = true;
    } : {
        v.w = false;
        v.twoBlocks = true;
    };
};
v.w ? {
    query.relative_block_has_any_tag(-2, 1.5, -1,'minecraft:replaceable') ? {
        v.w = true;
    } : {
        v.w = false;
        v.twoBlocks = true;
    };
};

//南
query.relative_block_has_any_tag(0, 1.5, 1,'minecraft:replaceable') ? {
    v.s = true;
} : {
    v.s = false;
    v.twoBlocks = false;
};
v.s ? {
    query.relative_block_has_any_tag(0, 1.5, 2,'minecraft:replaceable') ? {
        v.s = true;
    } : {
        v.s = false;
        v.twoBlocks = true;
    };
};
v.s ? {
    query.relative_block_has_any_tag(1, 1.5, 2,'minecraft:replaceable') ? {
        v.s = true;
    } : {
        v.s = false;
        v.twoBlocks = true;
    };
};
v.s ? {
    query.relative_block_has_any_tag(-1, 1.5, 2,'minecraft:replaceable') ? {
        v.s = true;
    } : {
        v.s = false;
        v.twoBlocks = true;
    };
};

//东
query.relative_block_has_any_tag(1, 1.5, 0,'minecraft:replaceable') ? {
    v.e = true;
} : {
    v.e = false;
    v.twoBlocks = false;
};
v.e ? {
    query.relative_block_has_any_tag(2, 1.5, 0,'minecraft:replaceable') ? {
        v.e = true;
    } : {
        v.e = false;
        v.twoBlocks = true;
    };
};
v.e ? {
    query.relative_block_has_any_tag(2, 1.5, 1,'minecraft:replaceable') ? {
        v.e = true;
    } : {
        v.e = false;
        v.twoBlocks = true;
    };
};
v.e ? {
    query.relative_block_has_any_tag(2, 1.5, -1,'minecraft:replaceable') ? {
        v.e = true;
    } : {
        v.e = false;
        v.twoBlocks = true;
    };
};

//四角检测
query.relative_block_has_any_tag( 1, 1.5, 1,'minecraft:replaceable') == 0 ? {
    v.e = false;
    v.s = false;
    v.twoBlocks = false;
};
query.relative_block_has_any_tag( -1, 1.5, 1,'minecraft:replaceable') == 0 ? {
    v.w = false;
    v.s = false;
    v.twoBlocks = false;
};
query.relative_block_has_any_tag( 1, 1.5, -1,'minecraft:replaceable') == 0 ? {
    v.e = false;
    v.n = false;
    v.twoBlocks = false;
};
query.relative_block_has_any_tag( -1, 1.5, -1,'minecraft:replaceable') == 0 ? {
    v.w = false;
    v.n = false;
    v.twoBlocks = false;
};

ctrl.run || ctrl.walk ? {
    ((v.e == false) && (query.cardinal_facing_2d == 5)) ? {
        ctrl.set_animation('defWall');
        return ctrl.state_continue;
    };
    (v.w == false) && (query.cardinal_facing_2d == 4) ? {
        ctrl.set_animation('defWall');
        return ctrl.state_continue;
    };
    (v.n == false) && (query.cardinal_facing_2d == 2) ? {
        ctrl.set_animation('defWall');
        return ctrl.state_continue;
    };
    (v.s == false) && (query.cardinal_facing_2d == 3) ? {
        ctrl.set_animation('defWall');
        return ctrl.state_continue;
    };
};
return ctrl.state_bypass;